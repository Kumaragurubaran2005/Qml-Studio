<Page x:Class="QML_Studio.OtherModelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#F8F9FD">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#148DF5"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#6547FF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#111729"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#71809F"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#0DB979"/>
        <SolidColorBrush x:Key="BadgeBackground" Color="#F1F5F9"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#070D1D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#F0F4FF"/>
            <Setter Property="BorderBrush" Value="#D6E2FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F8F9FD">
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E9F2" BorderThickness="0,0,0,1">
            <Grid Margin="24,16,24,0">
                <StackPanel>
                    <TextBlock Text="Quantum Machine Learning Studio" Foreground="#313A51" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ModelTitleText" Text="QSVM Configuration, Training &amp; Testing Studio" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock x:Name="ActiveDatasetText" Text="Active Dataset: Loading..." Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="10">
                    <TextBlock x:Name="TrainingStatusBadge" Text="Ready to train quantum model" Foreground="{StaticResource PurpleBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Width="28" Height="28" Background="#F1F2FF" CornerRadius="14">
                        <TextBlock Text="U" Foreground="{StaticResource PurpleBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT SCROLLVIEWER -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,35" Spacing="20">

                <!-- 1. COMMON DATASET & PREPROCESSING SHELL -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel Spacing="14">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📊 Common Dataset Shell &amp; Preprocessing" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource BadgeStyle}">
                                    <TextBlock Text="Shared across all 6 QML Models" Foreground="{StaticResource PurpleBrush}" FontSize="9" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Target Column Label" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <ComboBox x:Name="TargetColumnComboBox" HorizontalAlignment="Stretch" Height="32" FontSize="11" SelectedIndex="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
                                <TextBlock Text="Feature Scaling" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <ComboBox x:Name="ScalingComboBox" HorizontalAlignment="Stretch" Height="32" FontSize="11" SelectedIndex="0">
                                    <ComboBoxItem Content="StandardScaler"/>
                                    <ComboBoxItem Content="MinMaxScaler"/>
                                    <ComboBoxItem Content="None"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="12,0,0,0" Spacing="3">
                                <TextBlock Text="Dimensionality Reduction" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <ComboBox x:Name="PcaComboBox" HorizontalAlignment="Stretch" Height="32" FontSize="11" SelectedIndex="0">
                                    <ComboBoxItem Content="PCA (Auto N → Qubits)"/>
                                    <ComboBoxItem Content="Off"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="12,0,0,0" Spacing="3">
                                <TextBlock Text="Train / Test Split" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <ComboBox x:Name="SplitComboBox" HorizontalAlignment="Stretch" Height="32" FontSize="11" SelectedIndex="0">
                                    <ComboBoxItem Content="80 / 20 Holdout"/>
                                    <ComboBoxItem Content="70 / 30 Holdout"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="12,0,0,0" Spacing="3">
                                <TextBlock Text="Random Seed" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBox x:Name="RandomSeedTextBox" Text="42" Height="32" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <!-- COMPACT VALIDATION BADGES STRIP -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock x:Name="ValidationNumericBadge" Text="✓ Numeric Features Processed" Foreground="{StaticResource SuccessBrush}" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock x:Name="ValidationTargetBadge" Text="✓ Target Column Selected" Foreground="{StaticResource SuccessBrush}" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock x:Name="ValidationSplitBadge" Text="✓ Stratified Train/Test Split" Foreground="{StaticResource SuccessBrush}" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock x:Name="ValidationMappingBadge" Text="✓ Feature Mapping: Auto (N → Q Qubits)" Foreground="{StaticResource PurpleBrush}" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. DYNAMIC MODEL-SPECIFIC QUANTUM HYPERPARAMETERS PANEL -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="⚛ Model Selection &amp; Dynamic Quantum Configuration" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="Bold"/>

                        <!-- MODEL TYPE SELECTOR -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Algorithm Model Type" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="Bold"/>
                                <ComboBox x:Name="ModelTypeComboBox" HorizontalAlignment="Stretch" Height="34" FontSize="11" SelectedIndex="0" SelectionChanged="ModelTypeComboBox_SelectionChanged">
                                    <!-- Quantum Algorithms -->
                                    <ComboBoxItem Content="QSVM (Quantum Support Vector Machine)"/>
                                    <ComboBoxItem Content="QNN (Quantum Neural Network)"/>
                                    <ComboBoxItem Content="VQC (Variational Quantum Classifier)"/>
                                    <ComboBoxItem Content="QCNN (Quantum Convolutional Neural Network)"/>
                                    <ComboBoxItem Content="QKNN (Quantum k-Nearest Neighbors)"/>
                                    <ComboBoxItem Content="Quantum Kernel"/>

                                    <!-- Classical Counterpart Algorithms -->
                                    <ComboBoxItem Content="KNN (K-Nearest Neighbors)"/>
                                    <ComboBoxItem Content="SVM (Support Vector Machine)"/>
                                    <ComboBoxItem Content="MLP (Neural Network)"/>
                                    <ComboBoxItem Content="Logistic Regression"/>
                                    <ComboBoxItem Content="Kernel SVM"/>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Grid.Column="1" x:Name="ModelDescriptionText" Text="Dynamic quantum hyperparameters automatically adapt to the selected architecture." Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="20,15,0,0"/>
                        </Grid>

                        <Border Height="1" Background="#F0F2F8"/>

                        <!-- DYNAMIC HYPERPARAMETERS GRID -->
                        <Grid x:Name="DynamicHyperparametersGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Common 1: Qubits -->
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Qubits" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBox x:Name="QubitsTextBox" Text="4" Height="32" FontSize="11"/>
                            </StackPanel>

                            <!-- Common 2: Shots -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
                                <TextBlock Text="Shots" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBox x:Name="ShotsTextBox" Text="1024" Height="32" FontSize="11"/>
                            </StackPanel>

                            <!-- Common 3: Feature Map -->
                            <StackPanel Grid.Column="2" Margin="12,0,0,0" Spacing="3">
                                <TextBlock Text="Feature Map" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <ComboBox x:Name="FeatureMapComboBox" HorizontalAlignment="Stretch" Height="32" FontSize="11" SelectedIndex="0">
                                    <ComboBoxItem Content="ZZFeatureMap"/>
                                    <ComboBoxItem Content="PauliFeatureMap"/>
                                    <ComboBoxItem Content="ZFeatureMap"/>
                                    <ComboBoxItem Content="AngleEncoding"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- DYNAMIC FIELD CONTAINER 1 (Kernel or Ansatz) -->
                            <StackPanel Grid.Column="3" Margin="12,0,0,0" Spacing="3">
                                <TextBlock x:Name="DynamicField1Label" Text="Quantum Kernel" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <ComboBox x:Name="DynamicField1ComboBox" HorizontalAlignment="Stretch" Height="32" FontSize="11" SelectedIndex="0"/>
                            </StackPanel>

                            <!-- DYNAMIC FIELD CONTAINER 2 (Optimizer / SVM C / k Neighbors / Downstream) -->
                            <StackPanel Grid.Column="4" Margin="12,0,0,0" Spacing="3">
                                <TextBlock x:Name="DynamicField2Label" Text="SVM Parameter C" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <ComboBox x:Name="DynamicField2ComboBox" HorizontalAlignment="Stretch" Height="32" FontSize="11" SelectedIndex="0"/>
                            </StackPanel>
                        </Grid>

                        <!-- SECOND DYNAMIC ROW FOR ADVANCED MODEL CONTROLS (QNN/VQC/QCNN/QKNN) -->
                        <Grid x:Name="AdvancedDynamicRowGrid" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock x:Name="AdvField1Label" Text="Optimizer" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <ComboBox x:Name="AdvField1ComboBox" HorizontalAlignment="Stretch" Height="32" FontSize="11" SelectedIndex="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
                                <TextBlock x:Name="AdvField2Label" Text="Learning Rate / Max Iter" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBox x:Name="AdvField2TextBox" Text="0.01" Height="32" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="12,0,0,0" Spacing="3">
                                <TextBlock x:Name="AdvField3Label" Text="Epochs" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBox x:Name="AdvField3TextBox" Text="30" Height="32" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="12,0,0,0" Spacing="3">
                                <TextBlock x:Name="AdvField4Label" Text="Ansatz Reps" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBox x:Name="AdvField4TextBox" Text="2" Height="32" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <!-- TRAIN BUTTON -->
                        <Button x:Name="TrainModelButton"
                                Content="⚡ Train &amp; Evaluate Quantum Model"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="38"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                Click="TrainModelButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- 3. RESULTS DASHBOARD & MODEL INFORMATION SIDE PANEL -->
                <Grid x:Name="ResultsDashboard" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- MAIN RESULTS LEFT CONTAINER -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0" Spacing="16">

                        <!-- PERFORMANCE METRICS CARDS GRID -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="TRAIN ACCURACY" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TrainAccuracyText" Text="100%" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock x:Name="LossFinalText" Text="Convergence Loss: 0.000" Foreground="{StaticResource SuccessBrush}" FontSize="8"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="TEST ACCURACY" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TestAccuracyText" Text="100%" Foreground="{StaticResource PurpleBrush}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock x:Name="TestAccuracySubtitle" Text="Evaluated on 4 test samples" Foreground="{StaticResource SuccessBrush}" FontSize="8"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="F1-SCORE / ROC-AUC" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="F1ScoreText" Text="100% / 1.000" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Optimal Precision &amp; Recall" Foreground="{StaticResource SuccessBrush}" FontSize="8"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="SIMULATOR TIME" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TrainTimeText" Text="0.03s" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Executed via Qiskit Aer" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- MODEL-SPECIFIC VISUALIZATION PANEL -->
                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="ChartTitleText" Text="Quantum Optimization Curve &amp; Confusion Matrix" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="Bold"/>

                                <Grid Height="240">
                                    <Image x:Name="TrainingChartImage" Stretch="Uniform"/>
                                    <ProgressRing x:Name="TrainingLoadingContainer" IsActive="False" Visibility="Collapsed" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                    <Button x:Name="ViewQuantumCircuitButton" Content="◫ View Quantum Circuit" Style="{StaticResource PrimaryButtonStyle}" Height="30" Click="ViewQuantumCircuitButton_Click"/>
                                    <Button x:Name="GoToPredictionButton" Content="Go to Prediction Studio →" Style="{StaticResource PrimaryButtonStyle}" Height="30" Background="#6547FF" Click="GoToPredictionButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- MODEL INFORMATION RIGHT CARD -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" Height="420" VerticalAlignment="Top">
                        <StackPanel Spacing="12">
                            <TextBlock Text="MODEL ARCHITECTURE INFO" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="Bold"/>
                            <Border Height="1" Background="#F0F2F8"/>

                            <StackPanel Spacing="8">
                                <Grid Padding="0,2">
                                    <TextBlock Text="Learning Type" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
                                    <TextBlock x:Name="InfoLearningType" Text="Supervised" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Padding="0,2">
                                    <TextBlock Text="Quantum Component" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
                                    <TextBlock x:Name="InfoQuantumComponent" Text="Fidelity Quantum Kernel" Foreground="{StaticResource PurpleBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Padding="0,2">
                                    <TextBlock Text="Classical Component" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
                                    <TextBlock x:Name="InfoClassicalComponent" Text="Classical SVM" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Padding="0,2">
                                    <TextBlock Text="Trainable Parameters" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
                                    <TextBlock x:Name="InfoTrainableParams" Text="0" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Padding="0,2">
                                    <TextBlock Text="Circuit Depth" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
                                    <TextBlock x:Name="InfoCircuitDepth" Text="16" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Padding="0,2">
                                    <TextBlock Text="Quantum Gate Count" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
                                    <TextBlock x:Name="InfoGateCount" Text="48" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="#F0F2F8"/>
                            <TextBlock Text="Architecture Pipeline" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="Bold"/>

                            <Border Background="#F6F7FC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                                <TextBlock x:Name="InfoPipelineText" Text="Features → ZZFeatureMap → FidelityQuantumKernel → Kernel Matrix → Classical SVM → Prediction" Foreground="#313A51" FontSize="9" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
