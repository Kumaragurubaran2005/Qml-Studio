<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QML_Studio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QML_Studio"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="QML Studio">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!-- =========================
                 COLORS
                 ========================= -->
            <SolidColorBrush x:Key="SidebarBrush" Color="#080D1D"/>
            <SolidColorBrush x:Key="SidebarItemBrush" Color="#10162A"/>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#148DF5"/>
            <SolidColorBrush x:Key="PurpleBrush" Color="#6547FF"/>
            <SolidColorBrush x:Key="TextBrush" Color="#111729"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#71809F"/>

            <!-- =========================
                 SIDEBAR MENU BUTTON
                 ========================= -->
            <Style x:Key="SidebarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#9EA8C0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="Margin" Value="5,3"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="MenuBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="MenuBorder.Background" Value="#11182D"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="MenuBorder.Background" Value="#18223D"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="175"/>
            <!-- Main Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================
             SIDEBAR
             ====================================================== -->
        <Border x:Name="Sidebar"
                Grid.Column="0"
                Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="92"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>

                <!-- ===============================
                     LOGO
                     =============================== -->
                <StackPanel Grid.Row="0" Margin="16,22,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LogoCircle"
                                 Width="18" Height="18"
                                 Stroke="White" StrokeThickness="1.5"
                                 Fill="Transparent" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LogoText"
                                   Text="QML Studio"
                                   Foreground="White"
                                   FontSize="16" FontWeight="SemiBold"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="LogoSubtitle"
                               Text="QUANTUM MACHINE LEARNING"
                               Foreground="#8792AF" FontSize="8"
                               Margin="0,11,0,0"/>
                </StackPanel>

                <!-- ===============================
                     NAVIGATION
                     =============================== -->
                <StackPanel x:Name="NavigationPanel"
                            Grid.Row="1"
                            Margin="0,7,0,0">

                    <!-- Data Upload -->
                    <Button x:Name="DataUploadNavButton"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="{StaticResource SidebarItemBrush}"
                            Foreground="White"
                            Click="DataUploadNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↑" FontSize="14" Width="25" VerticalAlignment="Center"/>
                            <TextBlock Text="Data Upload" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Model Selection -->
                    <Button x:Name="ModelSelectionNavButton"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="ModelSelectionNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌘" FontSize="13" Width="25"/>
                            <TextBlock Text="Model Selection"/>
                        </StackPanel>
                    </Button>

                    <!-- Visualization -->
                    <Button x:Name="VisualizationNavButton"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="VisualizationNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◫" FontSize="12" Width="25"/>
                            <TextBlock Text="Visualization"/>
                        </StackPanel>
                    </Button>

                    <!-- Prediction -->
                    <Button x:Name="PredictionNavButton"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="PredictionNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▷" FontSize="12" Width="25"/>
                            <TextBlock Text="Prediction"/>
                        </StackPanel>
                    </Button>

                    <!-- Experiments -->
                    <Button x:Name="ExperimentsNavButton"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="ExperimentsNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" FontSize="11" Width="25"/>
                            <TextBlock Text="Experiments"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ===============================
                     WORKSPACE STATUS
                     =============================== -->
                <Border x:Name="WorkspaceStatusCard"
                        Grid.Row="2"
                        Margin="9,0,16,12"
                        Background="#0E1426"
                        BorderBrush="#222A42"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="WorkspaceStatusIcon"
                                 Width="23" Height="23"
                                 Fill="#F4F6FC" Grid.Column="0"/>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="WorkspaceStatusText"
                                       Text="Quantum-ready"
                                       Foreground="White" FontSize="9" FontWeight="SemiBold"/>

                            <TextBlock x:Name="WorkspaceStatusSubtitle"
                                       Text="Research workspace"
                                       Foreground="#727D9A" FontSize="8" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ======================================================
             MAIN CONTENT
             ====================================================== -->
        <Frame x:Name="ContentFrame" Grid.Column="1"/>
    </Grid>
</Window>

