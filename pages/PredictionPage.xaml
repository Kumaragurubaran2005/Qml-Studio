<Page x:Class="QML_Studio.pages.PredictionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#F8F9FD">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#148DF5"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#6547FF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#111729"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#71809F"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#DDE3F0"/>
        <SolidColorBrush x:Key="UploadBackgroundBrush" Color="#F6F7FC"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#0DB979"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#070D1D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PredictionTabStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#71809F"/>
            <Setter Property="BorderBrush" Value="#DDE3F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DDE3F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F9FAFE">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border x:Name="Header" Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E9F2" BorderThickness="0,0,0,1">
            <Grid Margin="23,20,26,0">
                <StackPanel>
                    <TextBlock x:Name="PageCategoryText" Text="Model Prediction &amp; Inference Studio" Foreground="#313A51" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageTitleText" Text="Real-Time Quantum Inference" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="Bold" Margin="0,7,0,0"/>
                    <TextBlock x:Name="PredictionStatusBadge" Text="Predictor inputs automatically exclude the target label column." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <Border x:Name="UserAvatar" Width="27" Height="27" Background="#F1F2FF" CornerRadius="15" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock x:Name="UserInitial" Text="U" Foreground="#6652E8" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- PAGE CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="PredictionContent" Margin="40,21,60,35">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- INPUT DATA CARD -->
                <Border x:Name="InputDataCard" Grid.Column="0" Style="{StaticResource CardStyle}" Height="540" Margin="0,0,24,0">
                    <StackPanel Margin="21,21,21,20">
                        <TextBlock x:Name="InputDataTitle" Text="Model Inference Input" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="InputDataDescription" Text="Target column is automatically excluded from inputs." Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" Margin="0,4,0,0"/>

                        <!-- INPUT TABS -->
                        <StackPanel x:Name="PredictionTabsPanel" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="SingleSampleTab" Content="Single sample" Style="{StaticResource PredictionTabStyle}" Background="#F4F1FF" BorderBrush="{StaticResource PurpleBrush}" Foreground="{StaticResource PurpleBrush}" Click="SingleSampleTab_Click"/>
                            <Button x:Name="BatchUploadTab" Content="Batch test upload" Style="{StaticResource PredictionTabStyle}" Click="BatchUploadTab_Click"/>
                        </StackPanel>

                        <!-- SINGLE SAMPLE CONTAINER -->
                        <StackPanel x:Name="SingleSampleContainer" Visibility="Visible">
                            <ScrollViewer Height="330" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <StackPanel x:Name="DynamicFeatureInputsPanel" Spacing="8"/>
                            </ScrollViewer>

                            <Button x:Name="RunPredictionButton"
                                    Content="▷ Run Single Prediction"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="35"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,15,0,0"
                                    Click="RunPredictionButton_Click"/>
                        </StackPanel>

                        <!-- BATCH UPLOAD CONTAINER -->
                        <StackPanel x:Name="BatchUploadContainer" Visibility="Collapsed" Spacing="14" Margin="0,15,0,0">
                            <Border BorderBrush="#DDE3F0" BorderThickness="1.5" CornerRadius="8" Background="#F6F7FC" Padding="15">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="📁 Upload Test Dataset (CSV)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Select test data CSV with predictor features." FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                    <Button x:Name="BrowseBatchFileButton" Content="Browse Test File..." Style="{StaticResource PrimaryButtonStyle}" Height="30" Margin="0,6,0,0" Click="BrowseBatchFileButton_Click"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="BatchFilePathText" Text="No test CSV selected." FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" HorizontalAlignment="Center"/>

                            <Button x:Name="RunBatchPredictionButton"
                                    Content="⚡ Execute Batch Predictions"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="35"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="False"
                                    Click="RunBatchPredictionButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- OUTPUT RESULTS CONTAINER -->
                <Grid Grid.Column="1">
                    <!-- SINGLE SAMPLE RESULTS GRID -->
                    <Grid x:Name="SingleSampleResultsGrid" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="120"/>
                            <RowDefinition Height="130"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER CHECK -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <Border Width="44" Height="44" Background="#F1F2FF" CornerRadius="22" HorizontalAlignment="Center">
                                <TextBlock Text="✓" Foreground="{StaticResource PurpleBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Quantum Model Inference Result" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- PREDICTED CLASS & CONFIDENCE -->
                        <StackPanel Grid.Row="1" Spacing="10">
                            <Border x:Name="PredictionClassCard" Width="320" Height="50" Background="#FFFFFF" BorderBrush="#DEE4F0" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Center">
                                <TextBlock x:Name="PredictionClassText" Text="Class 1 • Positive / Target" Foreground="{StaticResource PurpleBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Width="320" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="Model Confidence Score" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <Grid>
                                    <Border Height="8" Background="#E5E9F2" CornerRadius="4">
                                        <Border x:Name="ConfidenceBarFill" Width="290" Height="8" Background="{StaticResource PurpleBrush}" CornerRadius="4" HorizontalAlignment="Left"/>
                                    </Border>
                                    <TextBlock x:Name="ConfidenceValue" Text="96.4%" Foreground="{StaticResource TextBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- MODEL INSIGHTS CARD -->
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20" Margin="0,20,0,0">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Model Insights &amp; Circuit Fidelity" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="Bold"/>

                                <StackPanel Spacing="8">
                                    <Grid Padding="0,4">
                                        <TextBlock Text="Prediction Confidence" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                        <TextBlock x:Name="InsightConfidenceValue" Text="Optimal (96.4%)" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="#F0F2F8"/>

                                    <Grid Padding="0,4">
                                        <TextBlock Text="Model Architecture" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                        <TextBlock x:Name="InsightModelValue" Text="QSVM / Quantum Kernel Classifier" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="#F0F2F8"/>

                                    <Grid Padding="0,4">
                                        <TextBlock Text="Top Contributing Features" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                        <TextBlock x:Name="InsightFeaturesValue" Text="Feature 1 • Feature 3" Foreground="{StaticResource PurpleBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="#F0F2F8"/>
                                </StackPanel>

                                <Button x:Name="ViewQuantumCircuitButton" Content="View Full Visualizations ◫" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Height="30" Click="ViewQuantumCircuitButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- BATCH RESULTS CARD -->
                    <Border x:Name="BatchResultsCard" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel Spacing="12">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Batch Test Predictions Output" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <Button x:Name="OpenPredictionsCsvButton" Content="💾 Open Output Predictions CSV" Style="{StaticResource PrimaryButtonStyle}" Height="30" HorizontalAlignment="Right" Click="OpenPredictionsCsvButton_Click"/>
                            </Grid>

                            <TextBlock x:Name="BatchSummaryText" Text="Upload a test CSV and click Execute Batch Predictions." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>

                            <ListView x:Name="BatchPreviewListView" Height="380" BorderBrush="#E0E5F0" BorderThickness="1" CornerRadius="6">
                                <ListView.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10,6" Background="#F4F6FB">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Row #" FontWeight="Bold" FontSize="10" Foreground="#313A51"/>
                                            <TextBlock Grid.Column="1" Text="Predicted Target Label" FontWeight="Bold" FontSize="10" Foreground="#313A51"/>
                                            <TextBlock Grid.Column="2" Text="Confidence %" FontWeight="Bold" FontSize="10" Foreground="#313A51"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.HeaderTemplate>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:BatchRowPreviewModel" xmlns:local="using:QML_Studio">
                                        <Grid Padding="10,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind RowIndex}" FontSize="10" Foreground="#313A51"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind PredictedTarget}" FontSize="10" FontWeight="Bold" Foreground="#6547FF"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind ConfidencePct}" FontSize="10" FontWeight="SemiBold" Foreground="#0DB979"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
