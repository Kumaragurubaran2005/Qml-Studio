<Page x:Class="QML_Studio.pages.ExperimentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#F8F9FD">

    <Page.Resources>

        <!-- =========================
             COLORS
             ========================= -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#148DF5"/>

        <SolidColorBrush x:Key="PurpleBrush"
                         Color="#6547FF"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#111729"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#71809F"/>

        <SolidColorBrush x:Key="BorderBrushLight"
                         Color="#DDE3F0"/>

        <SolidColorBrush x:Key="WhiteBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="SuccessBrush"
                         Color="#0DB979"/>

        <SolidColorBrush x:Key="WarningBrush"
                         Color="#F0A11A"/>

        <SolidColorBrush x:Key="RunningBrush"
                         Color="#E84C4C"/>


        <!-- =========================
             PRIMARY BUTTON
             ========================= -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#070D1D"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="18,8"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================
             CARD STYLE
             ========================= -->

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#DDE3F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

        </Style>


        <!-- =========================
             FILTER BUTTON
             ========================= -->

        <Style x:Key="FilterButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#71809F"/>

            <Setter Property="BorderBrush"
                    Value="#DDE3F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="9"/>

            <Setter Property="Padding"
                    Value="12,6"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================
             STATUS BADGE
             ========================= -->

        <Style x:Key="CompletedStatusStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#E7FAF3"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

        </Style>


        <Style x:Key="RunningStatusStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#FFF0F0"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

        </Style>

    </Page.Resources>


    <!-- ==========================================================
         MAIN APPLICATION CONTENT
         ========================================================== -->

    <Grid x:Name="MainContent"
          Background="#F9FAFE">

        <Grid.RowDefinitions>

            <RowDefinition Height="100"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ==================================================
             HEADER
             ================================================== -->

        <Border x:Name="Header"
                Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E5E9F2"
                BorderThickness="0,0,0,1">

            <Grid Margin="23,20,26,0">

                <StackPanel>

                    <TextBlock x:Name="PageCategoryText"
                               Text="Experiments"
                               Foreground="#313A51"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="PageTitleText"
                               Text="Experiment tracking"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,7,0,0"/>

                    <TextBlock x:Name="PageDescriptionText"
                               Text="Log, compare and benchmark quantum machine learning runs."
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,2,0,0"/>

                </StackPanel>


                <!-- User avatar -->

                <Border x:Name="UserAvatar"
                        Width="27"
                        Height="27"
                        Background="#F1F2FF"
                        CornerRadius="15"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">

                    <TextBlock x:Name="UserInitial"
                               Text="U"
                               Foreground="#6652E8"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

            </Grid>

        </Border>


        <!-- ==================================================
             PAGE CONTENT
             ================================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="40,25,60,40"
                        Spacing="20">

                <Border Style="{StaticResource CardStyle}"
                        Padding="25">

                    <StackPanel Spacing="15">

                        <Grid>

                            <TextBlock Text="Recent Experiments"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="NewExperimentButton"
                                    Content="+ New experiment"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Click="NewExperimentButton_Click"/>

                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">

                            <Button x:Name="FilterAll"
                                    Content="All runs"
                                    Style="{StaticResource FilterButtonStyle}"
                                    Click="FilterAll_Click"/>

                            <Button x:Name="FilterCompleted"
                                    Content="Completed"
                                    Style="{StaticResource FilterButtonStyle}"
                                    Click="FilterCompleted_Click"/>

                            <Button x:Name="FilterRunning"
                                    Content="Running"
                                    Style="{StaticResource FilterButtonStyle}"
                                    Click="FilterRunning_Click"/>

                        </StackPanel>


                        <!-- Experiment List Table -->

                        <StackPanel Spacing="10"
                                    Margin="0,10,0,0">

                            <!-- Header Row -->

                            <Grid Background="#F5F7FA"
                                  Padding="12,8"
                                  CornerRadius="6">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="2*"/>

                                    <ColumnDefinition Width="1.5*"/>

                                    <ColumnDefinition Width="1*"/>

                                    <ColumnDefinition Width="1*"/>

                                    <ColumnDefinition Width="1*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Experiment Name"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#71809F"/>

                                <TextBlock Grid.Column="1"
                                           Text="Model"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#71809F"/>

                                <TextBlock Grid.Column="2"
                                           Text="Accuracy"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#71809F"/>

                                <TextBlock Grid.Column="3"
                                           Text="Shots"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#71809F"/>

                                <TextBlock Grid.Column="4"
                                           Text="Status"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#71809F"/>

                            </Grid>


                            <!-- Row 1 -->

                            <Grid Background="White"
                                  Padding="12,10"
                                  CornerRadius="6">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="2*"/>

                                    <ColumnDefinition Width="1.5*"/>

                                    <ColumnDefinition Width="1*"/>

                                    <ColumnDefinition Width="1*"/>

                                    <ColumnDefinition Width="1*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="iris_qknn_exp1"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>

                                <TextBlock Grid.Column="1"
                                           Text="QKNN (K=3)"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

                                <TextBlock Grid.Column="2"
                                           Text="96.7%"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"/>

                                <TextBlock Grid.Column="3"
                                           Text="1024"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

                                <Border Grid.Column="4"
                                        Style="{StaticResource CompletedStatusStyle}"
                                        Padding="8,2"
                                        HorizontalAlignment="Left">

                                    <TextBlock Text="Completed"
                                               FontSize="10"
                                               Foreground="{StaticResource SuccessBrush}"
                                               FontWeight="SemiBold"/>

                                </Border>

                            </Grid>


                            <!-- Row 2 -->

                            <Grid Background="White"
                                  Padding="12,10"
                                  CornerRadius="6">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="2*"/>

                                    <ColumnDefinition Width="1.5*"/>

                                    <ColumnDefinition Width="1*"/>

                                    <ColumnDefinition Width="1*"/>

                                    <ColumnDefinition Width="1*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="qsvm_churn_benchmark"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>

                                <TextBlock Grid.Column="1"
                                           Text="QSVM (Linear)"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

                                <TextBlock Grid.Column="2"
                                           Text="92.4%"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"/>

                                <TextBlock Grid.Column="3"
                                           Text="2048"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

                                <Border Grid.Column="4"
                                        Style="{StaticResource CompletedStatusStyle}"
                                        Padding="8,2"
                                        HorizontalAlignment="Left">

                                    <TextBlock Text="Completed"
                                               FontSize="10"
                                               Foreground="{StaticResource SuccessBrush}"
                                               FontWeight="SemiBold"/>

                                </Border>

                            </Grid>


                            <!-- Row 3 -->

                            <Grid Background="White"
                                  Padding="12,10"
                                  CornerRadius="6">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="2*"/>

                                    <ColumnDefinition Width="1.5*"/>

                                    <ColumnDefinition Width="1*"/>

                                    <ColumnDefinition Width="1*"/>

                                    <ColumnDefinition Width="1*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="qnn_cancer_training"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>

                                <TextBlock Grid.Column="1"
                                           Text="QNN (4 Qubits)"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

                                <TextBlock Grid.Column="2"
                                           Text="--"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

                                <TextBlock Grid.Column="3"
                                           Text="4096"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

                                <Border Grid.Column="4"
                                        Style="{StaticResource RunningStatusStyle}"
                                        Padding="8,2"
                                        HorizontalAlignment="Left">

                                    <TextBlock Text="Running..."
                                               FontSize="10"
                                               Foreground="{StaticResource RunningBrush}"
                                               FontWeight="SemiBold"/>

                                </Border>

                            </Grid>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>
