<Page
    x:Class="QML_Studio.QknnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QML_Studio"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!-- Colorful Gradient Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE8F4FF" Offset="0.0" />
                <GradientStop Color="#FFFFE6F6" Offset="0.5" />
                <GradientStop Color="#FFE6FFF0" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#CCFFFFFF" CornerRadius="12" Margin="30" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600" BorderBrush="#33000000" BorderThickness="1">
            <StackPanel Spacing="15">
                <TextBlock Text="Quantum KNN Integration" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#FF333333" />
                
                <!-- File Picker -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="SelectFileButton" Content="Select CSV File" Click="SelectFileButton_Click" Background="#FF4C9AFF" Foreground="White" CornerRadius="6" />
                    <TextBlock x:Name="SelectedFileTextBlock" Text="No file selected" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400" Foreground="#FF555555" />
                </StackPanel>

                <!-- Target Column -->
                <TextBox x:Name="TargetColumnTextBox" Header="Target Column Name" PlaceholderText="e.g. target" Background="White" />

                <!-- Query Vector -->
                <TextBox x:Name="QueryVectorTextBox" Header="Query Vector (comma-separated)" PlaceholderText="e.g. 8.0, 9.0" Background="White" />

                <!-- K and Shots -->
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <TextBox x:Name="KTextBox" Header="K (Neighbors)" Text="3" Width="100" Background="White" />
                    <TextBox x:Name="ShotsTextBox" Header="Shots" Text="1024" Width="100" Background="White" />
                </StackPanel>
                
                <Button x:Name="PredictButton" Content="Run Prediction" Click="PredictButton_Click" HorizontalAlignment="Center" Background="#FFFF4C8B" Foreground="White" CornerRadius="6" Padding="20,10" Margin="0,10,0,0"/>
                
                <ScrollViewer MaxHeight="200" Margin="0,10,0,0" Background="#EEFFFFFF" CornerRadius="8" Padding="10">
                    <TextBlock x:Name="ResultTextBlock" Text="Result will appear here." TextWrapping="Wrap" Foreground="#FF222222" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
